# Send only application inputs to the image builder.
**
!Dockerfile
!frontend/
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/vite.config.js
!frontend/src/
!frontend/src/**
!frontend/public/
!frontend/public/**
!backend/
!backend/package.json
!backend/package-lock.json
!backend/server.js
!backend/db.js
!backend/schema.sql
!backend/seed.sql
!backend/config/
!backend/config/**
!backend/lib/
!backend/lib/**
!backend/middleware/
!backend/middleware/**
!backend/migrations/
!backend/migrations/**
!backend/services/
!backend/services/**
!backend/scripts/
!backend/scripts/**

# Deny credentials even if a file is later placed in an allowed directory.
**/.env*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.database-backup.json
**/node_modules/**
**/dist/**
